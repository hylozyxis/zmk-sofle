#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        combo-left-bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <23 60>;
            layers = <0>;
        };

        combo-right-bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <24 60>;
            layers = <0>;
        };

        combo-minus {
            bindings = <&kp MINUS>;
            key-positions = <37>;
            layers = <0>;
        };

        combo-equal {
            bindings = <&kp EQUAL>;
            key-positions = <36 60>;
            layers = <0>;
        };

        comba-slash {
            bindings = <&kp SLASH>;
            key-positions = <22 60>;
            layers = <0>;
        };

        combo-backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <60 35>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&kp ESC       &kp N1      &kp N2     &kp N3    &kp N4     &kp N5         &kp UP_ARROW  &kp N6       &kp N7  &kp N8         &kp N9         &kp N0       &kp GRAVE
&kp TAB       &kp SQT     &kp COMMA  &kp DOT   &kp P      &kp Y          &kp DOWN      &kp F        &kp G   &kp C          &kp R          &kp L        &kp BACKSPACE
&kp LCTRL     &kp A       &kp O      &kp E     &kp U      &kp I          &kp LEFT      &kp D        &kp H   &kp T          &kp N          &kp S        &kp ENTER
&kp LSHFT     &kp SEMI    &kp Q      &kp J     &kp K      &kp X          &kp RIGHT     &kp B        &kp M   &kp W          &kp V          &kp Z        &kp RSHFT
&lt 4 C_MUTE  &lt 1 CAPS  &kp LGUI   &kp LALT  &kp SPACE  &lt 3 ENTER    &kp ENTER     &lt 2 ENTER  &mo 1   &kp RIGHT_WIN  &kp RIGHT_ALT  &lt 4 SLASH
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "DVORAK";
        };

        SYMBOL {
            bindings = <
&kp ESCAPE  &kp F1  &kp F2          &kp F3          &kp F4           &kp F5      &mmv MOVE_UP     &kp F6         &kp F7    &kp F8         &kp F9            &kp F10            &trans
&trans      &trans  &mkp LCLK       &kp UP          &mkp RCLK        &mkp MB4    &mmv MOVE_DOWN   &kp F11        &kp F12   &kp SLASH      &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans
&trans      &trans  &kp LEFT        &kp DOWN        &kp RIGHT        &mkp MB5    &mmv MOVE_LEFT   &kp PAGE_UP    &kp HOME  &kp BACKSLASH  &kp EQUAL         &kp MINUS          &trans
&trans      &trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans      &mmv MOVE_RIGHT  &kp PAGE_DOWN  &kp END   &trans         &trans            &trans             &trans
&kp C_MUTE  &trans  &trans          &trans          &trans           &trans      &mkp LCLK        &trans         &trans    &trans         &trans            &trans
            >;

            display-name = "SYM";
            sensor-bindings = <&scroll_encoder>;
        };

        FUNCTION {
            bindings = <
&trans  &trans  &trans   &trans   &trans   &trans    &trans  &trans    &trans    &trans  &trans     &trans  &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans    &trans  &trans    &trans    &trans  &trans     &trans  &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans    &trans  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans    &trans  &trans    &trans    &trans  &trans     &trans  &trans
&trans  &trans  &trans   &trans   &trans   &trans    &trans  &trans    &trans    &trans  &trans     &trans
            >;

            label = "FUN";
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans    &trans    &trans     &trans    &mmv MOVE_UP     &trans  &trans     &trans    &trans     &trans  &trans
&trans  &trans  &trans    &kp UP    &trans     &trans    &mmv MOVE_DOWN   &trans  &trans     &trans    &trans     &trans  &trans
&trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans    &mmv MOVE_LEFT   &trans  &mkp LCLK  &mkp MB3  &mkp RCLK  &trans  &trans
&trans  &trans  &trans    &trans    &trans     &trans    &mmv MOVE_RIGHT  &trans  &mkp MB4   &trans    &mkp MB5   &trans  &trans
&trans  &trans  &trans    &trans    &trans     &trans    &mkp LCLK        &trans  &trans     &trans    &trans     &trans
            >;

            label = "MOUSE";
        };

        SYSTEM {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0          &bt BT_SEL 1          &bt BT_SEL 2           &bt BT_SEL 3  &bt BT_SEL 4    &mmv MOVE_UP     &bt BT_CLR_ALL  &trans  &trans  &trans  &trans          &trans
&trans      &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_BRIGHTNESS_AUTO  &trans        &trans          &mmv MOVE_DOWN   &trans          &trans  &trans  &trans  &trans          &trans
&trans      &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp C_VOLUME_UP        &trans        &trans          &mmv MOVE_LEFT   &trans          &trans  &trans  &trans  &trans          &trans
&trans      &kp C_PREVIOUS        &kp C_PLAY_PAUSE      &kp C_NEXT             &trans        &trans          &mmv MOVE_RIGHT  &trans          &trans  &trans  &trans  &studio_unlock  &bootloader
&trans      &trans                &trans                &trans                 &trans        &trans          &mkp LCLK        &trans          &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&scroll_encoder>;
            label = "SYS";
        };
    };
};
